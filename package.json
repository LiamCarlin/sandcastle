{
  "name": "sandcastle-init",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sandcastle-init": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".sandcastle",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ci": "npm run typecheck && npm run test",
    "cli": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "vitest run --typecheck",
    "test:sandcastle": "node --test .sandcastle/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "sandcastle": "npx tsx --env-file=.sandcastle/.env .sandcastle/main.mts"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.6.6",
    "commander": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
